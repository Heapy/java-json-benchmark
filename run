#!/bin/sh -e

JAR=build/libs/app.jar
HEAP_SIZE=2g

if [ -z "${JVM_OPTIONS:-}" ]; then
    JVM_OPTIONS="-server -Xms${HEAP_SIZE} -Xmx${HEAP_SIZE} --add-opens=java.base/java.time=ALL-UNNAMED --add-modules=jdk.incubator.vector"
fi
if [ -z "${SEED:-}" ]; then
    SEED=$(date +%s)
    export SEED
fi
if [ -z "${SHADOW:-}" ]; then
    echo ./gradlew clean build shadowJar
    ./gradlew clean build shadowJar
fi

JAVA_COMMAND=java
if [ -n "${JAVA_HOME:-}" ]; then
    JAVA_COMMAND="${JAVA_HOME}/bin/java"
fi

exec "${JAVA_COMMAND}" ${JVM_OPTIONS} -jar "${JAR}" "$@"
